# ============================================
# T1D Companion - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# ============================================

# ============================================
# Application Settings
# ============================================
ENVIRONMENT=development
SECRET_KEY=your-super-secret-key-change-this-in-production

# Application
APP_TITLE=T1D Companion
VERSION=0.1.0

# ============================================
# Database Configuration
# ============================================
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/t1d_companion

# ============================================
# Redis Configuration (for Celery/Caching)
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# Security Settings
# ============================================
# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# CORS Configuration (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================
# Dexcom OAuth Configuration
# ============================================
# Register at: https://developer.dexcom.com/
DEXCOM_CLIENT_ID=your-dexcom-client-id
DEXCOM_CLIENT_SECRET=your-dexcom-client-secret
DEXCOM_REDIRECT_URI=http://localhost:8000/auth/dexcom/callback
DEXCOM_BASE_URL=https://api.dexcom.com/v3
# Set to "true" to use Dexcom sandbox environment for testing
DEXCOM_USE_SANDBOX=false

# ============================================
# Nightscout Configuration (for Libre, etc.)
# ============================================
# Nightscout is an open-source CGM data platform that can connect to Libre
# Set up at: https://nightscout.github.io/
NIGHTSCOUT_URL=https://your-nightscout-app.herokuapp.com
NIGHTSCOUT_API_TOKEN=your-api-token-here

# ============================================
# LLM Configuration
# ============================================
# Available providers: openai, anthropic, openrouter
# Recommended: openrouter (unified access with fallback)
LLM_PROVIDER=openrouter

# Model selection (optional, uses provider default if not set)
# OpenRouter format: "provider/model"
LLM_MODEL=openai/gpt-4o-mini

# OpenAI API Key (if using OpenAI directly)
OPENAI_API_KEY=sk-...

# Anthropic API Key (if using Anthropic directly)
ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter API Key (RECOMMENDED for unified access)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_REFERER=T1D-Companion

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60  # seconds

# ============================================
# File Upload Settings
# ============================================
MAX_UPLOAD_SIZE=10485760  # 10MB
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.gif

# ============================================
# Pagination Settings
# ============================================
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=100

# ============================================
# Development/Debug Settings
# ============================================
# Enable debug logging
DEBUG=false

# Log LLM requests (for debugging, increases log size)
LOG_LLM_REQUESTS=false

# ============================================
# Optional: Email Configuration
# ============================================
# For password reset and notifications
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USERNAME=your-email@gmail.com
# EMAIL_PASSWORD=your-email-password
# EMAIL_FROM=noreply@t1d-companion.com

# ============================================
# Deployment Settings
# ============================================
# For production deployments
# ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
# HTTPS_ONLY=true

# ============================================
# Getting Started
# ============================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in your API keys
# 3. Set LLM_PROVIDER and corresponding API key
# 4. Configure database connection
# 5. Configure Dexcom if using CGM integration
# 6. Start the application
#
# Recommended LLM Provider:
#   - Use OpenRouter for easiest setup
#   - Get API key from https://openrouter.ai/
#   - Set LLM_PROVIDER=openrouter
#   - Set OPENROUTER_API_KEY=sk-or-...
# ============================================
